# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Using OpenRouter (its endpoint is Anthropic-API-compatible):
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=sk-or-v1-...
EVAL_MODEL=anthropic/claude-haiku-4.5
#
# Using Anthropic directly instead: omit ANTHROPIC_BASE_URL, use an sk-ant-... key,
# and set EVAL_MODEL to a plain model id such as claude-haiku-4-5-20251001
